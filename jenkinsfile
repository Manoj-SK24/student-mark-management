pipeline {
    agent any

    stages {
        stage('Clone Repo') {
            steps {
                git 'https://github.com/Manoj-SK24/student-mark-mak.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -t student-mark-management .'
                }
            }
        }

        stage('Run Docker Container on 8081') {
            steps {
                script {
                    // stop and remove old container if running
                    sh 'docker rm -f student_mark_app || true'
                    // run new container mapped to port 8081
                    sh 'docker run -d -p 8081:80 --name student_mark_app student-mark-management'
                }
            }
        }
    }

    post {
        success {
            echo '✅ Deployment Successful! Access your app at http://localhost:8081'
        }
    }
}
